# Copy to .env.local and fill in. .env.local is git-ignored; this file is not.

# Local PostgreSQL (see compose.yaml). Choose any password; it never leaves this machine.
POSTGRES_PASSWORD=choose-a-local-password
DATABASE_URL=postgres://solas:choose-a-local-password@127.0.0.1:5432/solas
# Separate database for automated tests. Tests create it and wipe its tables.
TEST_DATABASE_URL=postgres://solas:choose-a-local-password@127.0.0.1:5432/solas_test

# Until owner sign-in exists (M9), changes to data are refused unless this is
# exactly "true". Only set it on your own machine, never on a server.
SOLAS_LOCAL_OWNER_MODE=true

# Agent workspaces: the only folder file tools may read, one subfolder per
# agent. Defaults to ~/Solas/workspaces when unset.
# SOLAS_WORKSPACES_DIR=/Users/you/Solas/workspaces
